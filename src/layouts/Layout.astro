---
import '@/styles/global.css';
import { PoufFooter } from '@/components/pouf/PoufFooter';
import { ToasterProvider } from '@/components/common/ToasterProvider';

interface Props {
  title?: string;
  description?: string;
  showFooter?: boolean;
}

const {
  title = 'Girls & Law | Masterclass: Litigio de Alto Impacto',
  description = 'Comunidad de mujeres multifacéticas en el derecho. Redefiniendo el ejercicio jurídico desde la autenticidad, la excelencia y la sororidad.',
  showFooter = true,
} = Astro.props;
---

<!doctype html>
<html lang="es" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    {/* Favicons / Tab Icons */}
    <link rel="icon" type="image/webp" href="/favicon.webp" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" href="/logogirlsandlaw-nobg.webp" />
    <meta name="generator" content={Astro.generator} />

    {/* Primary SEO */}
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content="Girls & Law, comunidad legal, mujeres en el derecho, masterclass litigio, abogadas" />

    {/* Google Fonts: Nunito Variable + Playfair Display */}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Nunito:ital,wght@0,400;0,600;0,700;0,800;0,900;1,700&family=Playfair+Display:ital,wght@0,600;0,700;0,800;1,400;1,600&display=swap"
      rel="stylesheet"
    />

    {/* Open Graph / Social */}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />

    {/* OAuth & Email Verification Redirect Auto-Detector: Si el proveedor o el correo de activación redirigen a la raíz con tokens, enviar de inmediato al dashboard */}
    <script is:inline>
      (function () {
        if (typeof window === 'undefined') return;
        var pathname = window.location.pathname;
        var hash = window.location.hash || '';
        var search = window.location.search || '';
        var hasAuthTokens =
          hash.indexOf('access_token=') !== -1 ||
          hash.indexOf('error=') !== -1 ||
          hash.indexOf('type=signup') !== -1 ||
          hash.indexOf('type=recovery') !== -1 ||
          hash.indexOf('type=email_change') !== -1 ||
          hash.indexOf('confirmation_token=') !== -1 ||
          search.indexOf('code=') !== -1 ||
          search.indexOf('type=') !== -1;
        if (hasAuthTokens && pathname !== '/dashboard' && pathname !== '/dashboard/') {
          window.location.replace('/dashboard' + search + hash);
        }
      })();
    </script>
  </head>
  <body class="min-h-screen flex flex-col bg-[#FFF5F9] text-ink antialiased font-pouf overflow-x-hidden w-full max-w-full">
    <ToasterProvider client:load />
    <main class="flex-1 w-full max-w-full overflow-x-hidden">
      <slot />
    </main>
    {showFooter && <PoufFooter client:load />}
  </body>
</html>
