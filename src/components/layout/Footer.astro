---
import Logo from '@/components/ui/Logo';
import { InstagramIcon, TikTokIcon, SpotifyIcon } from '@/components/ui/SocialIcons';
---

<footer class="bg-[#150F1D] text-white pt-16 pb-12 border-t border-pink-500/20">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-10 pb-12 border-b border-white/10">
      {/* Brand Info */}
      <div class="lg:col-span-2 space-y-4">
        <Logo variant="footer" />
        <p class="text-sm text-pink-100/70 max-w-sm leading-relaxed">
          La plataforma que acompaña a las mujeres en el derecho a construir
          su propia voz profesional sin renunciar a su autenticidad.
        </p>
        {/* Social Icons */}
        <div class="flex items-center gap-3 pt-2">
          <a
            href="https://instagram.com"
            target="_blank"
            rel="noreferrer"
            aria-label="Instagram"
            class="w-9 h-9 rounded-full bg-white/5 border border-white/10 flex items-center justify-center text-pink-400 hover:bg-[#E31B6D] hover:text-white transition-all"
          >
            <InstagramIcon className="w-4 h-4" />
          </a>
          <a
            href="https://tiktok.com"
            target="_blank"
            rel="noreferrer"
            aria-label="TikTok"
            class="w-9 h-9 rounded-full bg-white/5 border border-white/10 flex items-center justify-center text-pink-400 hover:bg-[#E31B6D] hover:text-white transition-all"
          >
            <TikTokIcon className="w-4 h-4" />
          </a>
          <a
            href="https://spotify.com"
            target="_blank"
            rel="noreferrer"
            aria-label="Spotify"
            class="w-9 h-9 rounded-full bg-white/5 border border-white/10 flex items-center justify-center text-pink-400 hover:bg-[#E31B6D] hover:text-white transition-all"
          >
            <SpotifyIcon className="w-4 h-4" />
          </a>
        </div>
      </div>

      {/* Links Column 1 */}
      <div>
        <h4 class="text-xs font-bold uppercase tracking-wider text-pink-300 mb-4">
          Comunidad
        </h4>
        <ul class="space-y-2.5 text-sm text-white/70">
          <li>
            <a href="#manifiesto" class="hover:text-pink-300 transition-colors">
              Manifiesto
            </a>
          </li>
          <li>
            <a href="#embajadas" class="hover:text-pink-300 transition-colors">
              Embajadas Universitarias
            </a>
          </li>
          <li>
            <a href="#mascota" class="hover:text-pink-300 transition-colors">
              Mascota &amp; Identidad
            </a>
          </li>
          <li>
            <a href="#fundadora" class="hover:text-pink-300 transition-colors">
              Mensaje Fundadora
            </a>
          </li>
        </ul>
      </div>

      {/* Links Column 2 */}
      <div>
        <h4 class="text-xs font-bold uppercase tracking-wider text-pink-300 mb-4">
          Recursos &amp; Contenido
        </h4>
        <ul class="space-y-2.5 text-sm text-white/70">
          <li>
            <a href="#libros" class="hover:text-pink-300 transition-colors">
              Libros &amp; Diseño
            </a>
          </li>
          <li>
            <a href="#podcast" class="hover:text-pink-300 transition-colors">
              Podcast en Spotify
            </a>
          </li>
          <li>
            <a href="#talleres" class="hover:text-pink-300 transition-colors">
              Workshops &amp; Litigio
            </a>
          </li>
          <li>
            <a href="#networking" class="hover:text-pink-300 transition-colors">
              Eventos de Networking
            </a>
          </li>
        </ul>
      </div>

      {/* Links Column 3 */}
      <div>
        <h4 class="text-xs font-bold uppercase tracking-wider text-pink-300 mb-4">
          Girls &amp; Law
        </h4>
        <ul class="space-y-2.5 text-sm text-white/70">
          <li>
            <a href="mailto:hola@girlsandlaw.com" class="hover:text-pink-300 transition-colors">
              Contacto de Prensa
            </a>
          </li>
          <li>
            <a href="#alianzas" class="hover:text-pink-300 transition-colors">
              Alianzas Institucionales
            </a>
          </li>
          <li>
            <a href="#privacidad" class="hover:text-pink-300 transition-colors">
              Política de Privacidad
            </a>
          </li>
        </ul>
      </div>
    </div>

    {/* Bottom Bar */}
    <div class="pt-8 flex flex-col sm:flex-row items-center justify-between text-xs text-white/50 gap-4">
      <p>© 2026 Girls &amp; Law. Todos los derechos reservados.</p>
      <p class="flex items-center gap-1.5">
        Creado con <span class="text-[#E31B6D]">♥</span> para la comunidad jurídica.
      </p>
    </div>
  </div>
</footer>
